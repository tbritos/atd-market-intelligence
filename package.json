{
  "name": "atd-workspace-monitor-api",
  "version": "1.0.0",
  "description": "API para monitoramento de workspace ATD",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts --watch src -e ts",
    "dev:worker": "nodemon src/worker.ts --watch src -e ts",
    "dev:schedulers": "nodemon src/schedulers.ts --watch src -e ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:worker\" \"npm run dev:schedulers\"",
    "start": "ts-node src/server.ts",
    "start:worker": "ts-node src/worker.ts",
    "build": "tsc",
    "test": "vitest",
    "test-ci": "vitest --coverage --run",
    "migrate": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "prepare": "prisma generate",
    "script:pagespeed": "ts-node src/scripts/run-pagespeed.ts",
    "script:import-apify": "ts-node --transpile-only src/scripts/import-apify-google-places.ts",
    "script:abort-apify": "ts-node --transpile-only src/scripts/abort-apify-runs.ts",
    "script:audit-google-places": "ts-node --transpile-only src/scripts/audit-google-places-import.ts",
    "script:audit-brand-sites": "ts-node --transpile-only src/scripts/audit-brand-sites.ts"
  },
  "keywords": [
    "api",
    "typescript",
    "express",
    "prisma"
  ],
  "author": "Emanuel Campos",
  "license": "ISC",
  "dependencies": {
    "@bull-board/express": "^6.12.7",
    "@bull-board/ui": "^6.12.7",
    "@prisma/client": "^5.8.0",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.11.0",
    "bullmq": "^5.58.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-basic-auth": "^1.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.7.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "redis": "^5.8.2",
    "slugify": "^1.6.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.1",
    "concurrently": "^9.2.1",
    "exceljs": "^4.4.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.21.1",
    "vitest": "^2.1.3"
  }
}
